  "color": {
    "brand-red": {
      "$type": "color",
      "$value": "#C83D45",
      "role": "present brand and operations-status accent"
    },
    "surface": {
      "$type": "color",
      "$value": "#F4F2EE",
      "role": "warm light information surface"
    },
    "paper": {
      "$type": "color",
      "$value": "#FFFFFF",
      "role": "puzzle and map surface"
    },
    "ink": {
      "$type": "color",
      "$value": "#20272C",
      "role": "primary text and released map line"
    },
    "track-brown": {
      "$type": "color",
      "$value": "#805535",
      "role": "six concrete track forms only"
    },
    "assumption-gray": {
      "$type": "color",
      "$value": "#727B82",
      "role": "open occupancy note and exactly fulfilled count; never a concrete gray curve"
    },
    "empty-red": {
      "$type": "color",
      "$value": "#B42E39",
      "role": "optional empty-cell X; objective count overrun, never an assumption truth judgment"
    },
    "selection-yellow": {
      "$type": "color",
      "$value": "#F1C84B",
      "role": "tool and cell selection only; never solution, reward, or game state"
    },
    "selection-edge": {
      "$type": "color",
      "$value": "#6C5717",
      "role": "geometric selection outline"
    },
    "grid-line": {
      "$type": "color",
      "$value": "#CCD0D1",
      "role": "quiet grid line"
    }
