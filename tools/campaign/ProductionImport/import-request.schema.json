{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"STP authoring ProductionImport request v1",
  "type":"object","additionalProperties":false,
  "required":["importRequestVersion","use","publicCatalog","campaign","campaignCompletion","endlessCompletion","calibration","cosmetics","profiles","levels","localizations","railwayAssets","releaseLock","toolchainLock","uiSourceLock","evidence","publishedLocks"],
  "properties":{
    "importRequestVersion":{"const":1},"use":{"enum":["Production","ContractTest"]},
    "publicCatalog":{"type":"object","additionalProperties":false,"required":["catalogId","revision"],"properties":{"catalogId":{"type":"string","minLength":1},"revision":{"type":"integer","minimum":1,"maximum":2147483647}}},
    "campaign":{"$ref":"#/$defs/path"},"campaignCompletion":{"$ref":"#/$defs/path"},"endlessCompletion":{"$ref":"#/$defs/path"},"calibration":{"$ref":"#/$defs/path"},"cosmetics":{"$ref":"#/$defs/path"},
    "profiles":{"type":"array","minItems":4,"maxItems":4,"uniqueItems":true,"items":{"$ref":"#/$defs/path"}},
    "levels":{"type":"array","minItems":240,"maxItems":240,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["level","proof"],"properties":{"level":{"$ref":"#/$defs/path"},"proof":{"$ref":"#/$defs/path"}}}},
    "localizations":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"$ref":"#/$defs/path"}},
    "railwayAssets":{"$ref":"#/$defs/path"},"releaseLock":{"$ref":"#/$defs/path"},"toolchainLock":{"$ref":"#/$defs/path"},"uiSourceLock":{"$ref":"#/$defs/path"},
    "evidence":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"$ref":"#/$defs/path"}},
    "publishedLocks":{"type":"array","maxItems":256,"items":{"type":"object","additionalProperties":false,"required":["lock","catalogs"],"properties":{"lock":{"$ref":"#/$defs/reference"},"catalogs":{"type":"array","minItems":1,"maxItems":64,"uniqueItems":true,"items":{"$ref":"#/$defs/reference"}}}}}
  },
  "$defs":{
    "path":{"type":"string","minLength":1,"maxLength":512,"pattern":"^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[^/]+(?:/[^/]+)*$"},
    "reference":{"type":"object","additionalProperties":false,"required":["path","rawSha256"],"properties":{"path":{"$ref":"#/$defs/path"},"rawSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}
  }
}
