.saved-scroll { flex-grow: 1; width: 100%; height: 100%; min-height: 0; }
.saved-scroll .unity-scroll-view__content-viewport { min-width: 0; }
.saved-scroll .unity-scroll-view__content-container { width: 100%; max-width: 100%; min-width: 0; align-self: stretch; }
.saved-page { flex-grow: 0; flex-shrink: 0; width: 100%; min-width: 0; max-width: 1100px; align-self: center; padding: 6px; background-color: rgb(240, 241, 237); color: rgb(37, 43, 45); }
.saved-boundary { font-size: 12px; white-space: normal; padding: 5px; background-color: rgb(224, 228, 225); }
.saved-status { white-space: normal; font-size: 13px; -unity-font-style: bold; margin-top: 3px; }
.saved-error { white-space: normal; color: rgb(150, 35, 30); font-size: 12px; }
.saved-progress, .saved-current, .saved-stars { white-space: normal; font-size: 11px; }
.saved-picker { margin-top: 3px; }
.saved-actions { flex-direction: row; flex-wrap: wrap; }
.saved-actions > Button { min-height: 27px; margin: 2px; padding-left: 8px; padding-right: 8px; font-size: 12px; }
.saved-candidates { flex-shrink: 0; }
.saved-candidate { white-space: normal; min-height: 27px; margin: 2px; font-size: 11px; }
.saved-candidate--selected { background-color: rgb(255, 222, 101); }
.saved-confirmation { padding: 6px; background-color: rgb(255, 242, 206); flex-shrink: 0; }
.saved-confirmation Label { white-space: normal; }
.saved-game-host { flex-grow: 0; flex-shrink: 0; }
.saved-game-host:disabled { opacity: 1; }
.saved-game-host .qa-page { padding: 3px; flex-grow: 0; flex-shrink: 0; min-width: 0; max-width: 100%; }
.saved-game-host .qa-tools, .saved-game-host .qa-actions { min-width: 0; max-width: 100%; flex-wrap: wrap; }
.saved-game-host .qa-grid-host, .saved-game-host .qa-grid { height: 540px; min-height: 540px; max-height: 540px; flex-grow: 0; flex-shrink: 0; }
.saved-page > *, .saved-game-host .qa-page > * { flex-shrink: 0; }
.saved-game-host .qa-boundary { display: none; }
.saved-game-host .qa-picker-bar, .saved-game-host #qa-restart { display: none; }
.saved-game-host .qa-header { margin-top: 2px; }
.saved-game-host .qa-title { font-size: 17px; }
.saved-game-host .qa-tool, .saved-game-host .qa-action { min-height: 28px; margin: 2px; font-size: 12px; }
.saved-game-host .qa-result { padding: 5px; }
