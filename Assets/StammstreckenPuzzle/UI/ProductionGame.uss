.production-root { flex-grow: 1; width: 100%; height: 100%; min-height: 0; background-color: #F4F2EE; color: #20272C; -unity-font-definition: url("../Art/Fonts/IBMPlexSans-Regular.ttf"); font-size: 15px; }
.screen { flex-grow: 1; min-height: 0; }
.hidden { display: none; }
Label { margin: 0; padding: 0; }
Button { margin: 0; color: #20272C; border-width: 1px; border-color: #CCD0D1; background-color: white; border-radius: 6px; -unity-text-align: middle-center; -unity-font-definition: url("../Art/Fonts/IBMPlexSans-SemiBold.ttf"); }
Button:hover { background-color: #ECEAE5; }
Button:active { background-color: #E5E1D8; }
Button:disabled { opacity: 0.58; }
.home-header { flex-direction: row; align-items: center; justify-content: space-between; padding: 18px 20px 16px 20px; flex-shrink: 0; }
.brand-block { flex-shrink: 1; }
.wordmark { font-size: 21px; -unity-font-definition: url("../Art/Fonts/IBMPlexSansCondensed-SemiBold.ttf"); letter-spacing: 0.5px; }
.microcopy { font-size: 10px; margin-top: 3px; color: #59636A; }
.balance { font-size: 12px; padding: 7px 9px; background-color: white; border-radius: 5px; margin-left: 10px; }
.status-strip { background-color: #C83D45; color: white; padding: 9px 20px; font-size: 11px; letter-spacing: 1px; -unity-font-definition: url("../Art/Fonts/IBMPlexSansCondensed-SemiBold.ttf"); flex-shrink: 0; }
.home-art { height: 212px; flex-shrink: 1; min-height: 140px; overflow: hidden; }
.railway-illustration { flex-grow: 1; width: 100%; height: 100%; }
.home-copy { padding: 16px 22px 10px 22px; flex-shrink: 0; }
.eyebrow { font-size: 11px; letter-spacing: 1px; -unity-font-definition: url("../Art/Fonts/IBMPlexSans-SemiBold.ttf"); color: #59636A; }
.hero-title { font-size: 32px; margin-top: 5px; white-space: normal; -unity-font-definition: url("../Art/Fonts/IBMPlexSansCondensed-SemiBold.ttf"); }
.body-copy { font-size: 14px; white-space: normal; margin-top: 12px; margin-bottom: 12px; }
.route-caption { font-size: 12px; margin-top: 2px; margin-bottom: 16px; }
.primary-button { height: 52px; min-height: 48px; background-color: #C83D45; border-color: #C83D45; color: white; font-size: 13px; letter-spacing: 0.5px; margin-top: 4px; flex-shrink: 0; }
.primary-button:hover { background-color: #B9343D; }
.primary-button:active { background-color: #A82D36; }
.secondary-button { min-height: 44px; font-size: 12px; background-color: transparent; margin-top: 8px; flex-shrink: 0; }
.progress-row { flex-direction: row; justify-content: space-between; margin-top: 14px; margin-bottom: 7px; }
.small-copy { font-size: 11px; color: #59636A; }
.main-navigation { height: 64px; flex-shrink: 0; flex-direction: row; border-top-width: 1px; border-top-color: #CCD0D1; background-color: white; padding: 6px 12px; }
.nav-button { flex-grow: 1; flex-basis: 0; border-width: 0; border-radius: 4px; font-size: 12px; color: #59636A; }
.nav--active { background-color: #F4F2EE; color: #C83D45; border-bottom-width: 3px; border-bottom-color: #C83D45; }
.page-header { height: 70px; flex-direction: row; align-items: center; padding: 12px 18px; flex-shrink: 0; }
.page-title { font-size: 23px; white-space: normal; -unity-font-definition: url("../Art/Fonts/IBMPlexSansCondensed-SemiBold.ttf"); }
.small-button { min-width: 44px; min-height: 40px; font-size: 11px; padding: 4px 9px; }
.page-header .small-button { margin-right: 14px; }
.map-art { height: 176px; flex-shrink: 1; min-height: 120px; }
.map-title { font-size: 26px; margin: 20px 22px 8px 22px; -unity-font-definition: url("../Art/Fonts/IBMPlexSansCondensed-SemiBold.ttf"); white-space: normal; }
.map-body { font-size: 13px; white-space: normal; margin: 0 22px 12px 22px; }
.map-nodes { flex-direction: row; flex-wrap: wrap; margin: 5px 18px; justify-content: space-between; }
.map-node { width: 21%; height: 52px; margin: 7px 1%; border-radius: 26px; border-width: 2px; background-color: #E8E7E1; color: #59636A; }
.map-node--cleared { background-color: #20272C; border-color: #20272C; color: white; }
.map-node--current { background-color: #C83D45; border-color: #20272C; color: white; }
.map-legend { margin: 16px 24px; font-size: 11px; white-space: normal; }
.puzzle-screen { background-color: #F4F2EE; }
.puzzle-header { height: 78px; flex-shrink: 0; flex-direction: row; align-items: center; padding: 12px 14px; border-bottom-width: 1px; border-bottom-color: #DADBD7; }
.icon-button { width: 44px; height: 44px; flex-shrink: 0; font-size: 19px; }
.puzzle-heading { flex-grow: 1; flex-shrink: 1; margin-left: 12px; margin-right: 5px; }
.puzzle-context { font-size: 10px; color: #59636A; white-space: normal; }
.puzzle-title { font-size: 19px; -unity-font-definition: url("../Art/Fonts/IBMPlexSansCondensed-SemiBold.ttf"); white-space: normal; }
.puzzle-time { width: 44px; font-size: 12px; color: #59636A; -unity-text-align: middle-right; }
.puzzle-subheader { height: 44px; min-height: 44px; flex-shrink: 0; flex-direction: row; align-items: center; padding: 0 18px; }
.puzzle-phase { flex-grow: 1; font-size: 10px; color: #59636A; white-space: normal; }
.text-button { height: 36px; min-width: 54px; border-width: 0; background-color: transparent; font-size: 11px; margin-left: 6px; }
.puzzle-viewport { flex-grow: 1; flex-shrink: 1; min-height: 120px; margin: 0 9px; }
.puzzle-viewport > .unity-scroll-view__content-viewport { flex-grow: 1; }
.puzzle-viewport .unity-scroll-view__content-container { width: 100%; height: 100%; flex-shrink: 0; }
.puzzle-grid { width: 100%; height: 100%; min-height: 120px; flex-shrink: 0; }
.puzzle-board { position: absolute; background-color: white; }
.puzzle-cell { position: absolute; margin: 0; padding: 0; border-width: 0.5px; border-color: #CCD0D1; border-radius: 0; background-color: white; opacity: 1; }
.puzzle-cell:disabled { background-color: white; opacity: 1; }
.puzzle-cell:hover { background-color: #F4F2EE; }
.puzzle-cell:active { background-color: #E8E6DF; }
.track-glyph { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.puzzle-count { position: absolute; font-size: 15px; -unity-font-definition: url("../Art/Fonts/IBMPlexSans-SemiBold.ttf"); -unity-text-align: middle-center; }
.puzzle-count--exact { color: #657078; }
.puzzle-count--exceeded { color: #B42E39; }
.puzzle-endpoint { position: absolute; background-color: #C83D45; color: white; border-radius: 9px; font-size: 11px; -unity-text-align: middle-center; }
.puzzle-grid--ride .puzzle-count { opacity: 0.3; }
.tool-dock { height: 192px; flex-shrink: 0; padding: 10px 16px 12px 16px; background-color: white; border-top-width: 1px; border-top-color: #CCD0D1; }
.tool-dock-heading { height: 40px; flex-direction: row; align-items: center; margin-bottom: 7px; }
.tool-dock-heading .eyebrow { flex-grow: 1; }
.tool-dock-heading .small-button { margin-left: 6px; }
.tool-row { flex-direction: row; height: 54px; margin-bottom: 6px; justify-content: space-between; }
.tool-button { height: 50px; width: 15.4%; padding: 0; border-radius: 5px; border-color: #CCD0D1; border-width: 1px; flex-shrink: 0; }
.tool--active { background-color: #F1C84B; border-color: #6C5717; border-width: 2px; }
.tool--active:hover { background-color: #F1C84B; }
.note-row { justify-content: flex-start; }
.note-tool { width: 16%; margin-right: 6px; }
.tool-caption { flex-grow: 1; flex-shrink: 1; font-size: 10px; white-space: normal; margin-left: 8px; -unity-text-align: middle-left; color: #59636A; }
.result-panel { position: absolute; left: 18px; right: 18px; bottom: 18px; background-color: white; border-color: #20272C; border-width: 2px; border-radius: 10px; padding: 21px; }
.result-title { font-size: 26px; -unity-font-definition: url("../Art/Fonts/IBMPlexSansCondensed-SemiBold.ttf"); white-space: normal; }
.result-stars { font-size: 17px; margin-top: 10px; margin-bottom: 9px; }
.result-time { font-size: 17px; margin-bottom: 8px; }
.result-balance { font-size: 13px; margin-top: 12px; margin-bottom: 14px; }
.standalone-title { font-size: 30px; margin: 26px 22px 8px 22px; -unity-font-definition: url("../Art/Fonts/IBMPlexSansCondensed-SemiBold.ttf"); }
.page-subtitle { margin: 0 22px 18px 22px; font-size: 13px; white-space: normal; }
.depot-art { height: 280px; flex-shrink: 1; }
.depot-scroll { flex-grow: 1; min-height: 0; }
.depot-catalog { padding: 0 18px 20px 18px; }
.cosmetic-card { background-color: white; border-width: 1px; border-color: #CCD0D1; border-radius: 8px; padding: 12px; margin-bottom: 12px; }
.cosmetic-illustration { width: 100%; height: 165px; margin-bottom: 11px; }
.cosmetic-title { font-size: 19px; white-space: normal; -unity-font-definition: url("../Art/Fonts/IBMPlexSansCondensed-SemiBold.ttf"); }
.cosmetic-state { font-size: 11px; color: #59636A; margin-top: 7px; }
.profile-card { margin: 8px 22px; padding: 22px; background-color: white; border-radius: 8px; }
.profile-stat { font-size: 24px; margin-bottom: 16px; -unity-font-definition: url("../Art/Fonts/IBMPlexSansCondensed-SemiBold.ttf"); white-space: normal; }
.overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(32,39,44,0.6); align-items: center; justify-content: center; padding: 22px; }
.overlay-card { width: 100%; max-width: 420px; background-color: #F4F2EE; padding: 24px; border-radius: 10px; border-width: 2px; border-color: #20272C; }
.hint-credits { font-size: 12px; color: #59636A; margin-top: 12px; }
.hint-fact { font-size: 22px; white-space: normal; margin-top: 20px; -unity-font-definition: url("../Art/Fonts/IBMPlexSansCondensed-SemiBold.ttf"); }
.hint-state { font-size: 11px; color: #59636A; white-space: normal; margin-bottom: 16px; }

.daily-open-button { min-height: 44px; font-size: 12px; border-width: 0; background-color: transparent; color: #59636A; margin-top: 4px; }
.daily-odds { white-space: normal; font-size: 13px; padding: 12px; background-color: #E7E5DD; border-radius: 5px; }
.daily-result { font-size: 25px; white-space: normal; margin-top: 20px; -unity-font-definition: url("../Art/Fonts/IBMPlexSansCondensed-SemiBold.ttf"); }
.daily-card .small-copy { margin-top: 14px; }
.wrapping { white-space: normal; }
.settings-card { max-height: 92%; padding: 20px; }
.settings-scroll { min-height: 0; flex-shrink: 1; margin-top: 8px; }
.settings-heading { margin-top: 18px; margin-bottom: 8px; font-size: 12px; color: #59636A; -unity-font-definition: url("../Art/Fonts/IBMPlexSans-SemiBold.ttf"); }
.settings-audio-row { margin-bottom: 14px; }
.settings-audio-label { font-size: 13px; margin-bottom: 6px; }
.settings-audio-choices { flex-direction: row; }
.settings-volume { flex-grow: 1; flex-basis: 0; min-height: 44px; margin-right: 5px; font-size: 12px; }
.settings-choice--active { border-color: #C83D45; border-width: 2px; color: #C83D45; }
.settings-state { margin-top: 10px; }
.result-art { height: 100px; flex-shrink: 0; margin-top: 10px; overflow: hidden; }
.result-copy { font-size: 13px; white-space: normal; margin-top: 10px; }
.puzzle-title { max-height: 46px; overflow: hidden; }
.puzzle-phase { max-height: 40px; overflow: hidden; }

.home-scroll { flex-grow: 1; min-height: 0; }
.home-scroll .home-art { flex-shrink: 0; }

.map-pager { flex-direction: row; align-items: center; margin: 16px 18px 8px 18px; }
.map-pager .map-title { flex-grow: 1; flex-shrink: 1; font-size: 22px; margin: 0 8px; -unity-text-align: middle-center; }

.puzzle-phase { min-width: 0; max-width: 100%; flex-basis: 0; flex-grow: 1; flex-shrink: 1; white-space: normal; }
.puzzle-subheader .text-button { width: 62px; min-width: 62px; max-width: 62px; flex-shrink: 0; }
.puzzle-heading { min-width: 0; max-width: 100%; }

.endless-card { max-height: 92%; padding: 20px; }
.endless-scroll { min-height: 0; flex-shrink: 1; }
.endless-profiles { margin-top: 14px; }
.endless-profile-button { min-height: 58px; white-space: normal; margin-bottom: 10px; font-size: 13px; }
.endless-record { padding: 14px; background-color: white; border-radius: 6px; margin-top: 12px; }
.profile-scroll { flex-grow: 1; min-height: 0; }
.profile-records { margin: 8px 22px 22px 22px; }
.profile-record { background-color: white; margin-bottom: 10px; padding: 14px; border-radius: 6px; font-size: 12px; }
.profile-record-title { font-size: 17px; white-space: normal; margin-bottom: 6px; -unity-font-definition: url("../Art/Fonts/IBMPlexSansCondensed-SemiBold.ttf"); }
.completion-state { margin-top: 12px; margin-bottom: 6px; }
.result-panel { height: 82%; max-height: 720px; min-height: 0; }
.result-panel .unity-scroll-view__content-container > * { flex-shrink: 0; }
.result-mode { margin-top: 12px; }
.map-node { white-space: normal; font-size: 12px; }

.endless-art { height: 130px; flex-shrink: 0; margin-top: 12px; overflow: hidden; }
.unity-scroller--vertical { width: 6px; min-width: 6px; max-width: 6px; }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }
.unity-scroller--vertical .unity-base-slider__dragger { width: 4px; min-width: 4px; border-width: 0; border-radius: 2px; background-color: #B7BDBB; }
.unity-scroller--vertical .unity-base-slider__tracker { border-width: 0; background-color: transparent; }

.human-screen { padding: 28px 22px 24px 22px; }
.human-intro-scroll { flex-grow: 1; min-height: 0; }
.human-intro-scroll .primary-button, .human-intro-scroll .secondary-button { margin-top: 12px; }
.human-contact { height: 228px; padding-top: 8px; padding-bottom: 8px; }
.human-contact-title { font-size: 12px; white-space: normal; -unity-font-definition: url("../Art/Fonts/IBMPlexSans-SemiBold.ttf"); }
.human-contact-options { flex-direction: row; margin-top: 6px; flex-shrink: 0; }
.human-contact-option { min-height: 46px; flex-grow: 1; flex-basis: 0; font-size: 11px; white-space: normal; margin-right: 4px; }
.human-contact-option:last-child { margin-right: 0; }
.human-contact-option--selected { border-color: #C83D45; border-width: 2px; background-color: #F9E8E8; }
.human-prior-version { min-height: 44px; font-size: 11px; margin-top: 5px; flex-shrink: 0; white-space: normal; }
.human-contact-confirm { min-height: 44px; height: 44px; margin-top: 5px; font-size: 12px; }
.human-menu-card { max-height: 90%; }
