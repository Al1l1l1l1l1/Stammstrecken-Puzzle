{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stammstrecken-puzzle.invalid/schemas/proof-v1.schema.json",
  "title": "Stammstrecken-Puzzle Solver Proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["proofFormatVersion", "puzzleId", "publicPuzzleHash", "solutionHash", "solverVersion", "solutionCount", "metrics", "proofHash"],
  "properties": {
    "proofFormatVersion": {"const": 1},
    "puzzleId": {"type": "string", "pattern": "^S[1-9][0-9]*-[0-9]{2}-[0-9]{2}-[0-9]{2}$"},
    "publicPuzzleHash": {"$ref": "#/$defs/profiledHash"},
    "solutionHash": {"$ref": "#/$defs/profiledHash"},
    "solverVersion": {"type": "string", "pattern": "^solver-v[1-9][0-9]*$"},
    "solutionCount": {"const": 1},
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["searchNodes", "deductionSteps", "maxDeductionDepth", "requiredGuessDepth"],
      "properties": {
        "searchNodes": {"type": "integer", "minimum": 1},
        "deductionSteps": {"type": "integer", "minimum": 1},
        "maxDeductionDepth": {"type": "integer", "minimum": 1},
        "requiredGuessDepth": {"type": "integer", "minimum": 0}
      }
    },
    "proofHash": {"$ref": "#/$defs/profiledHash"}
  },
  "$defs": {
    "profiledHash": {
      "type": "object", "additionalProperties": false, "required": ["profile", "sha256"],
      "properties": {"profile": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    }
  }
}
