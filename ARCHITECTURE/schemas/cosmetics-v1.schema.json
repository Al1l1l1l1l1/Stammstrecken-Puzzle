{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stammstrecken-puzzle.invalid/schemas/cosmetics-v1.schema.json",
  "title": "Stammstrecken-Puzzle Cosmetics Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "catalogRevision", "approvalStatus", "items"],
  "properties": {
    "schemaVersion": {"const": 1},
    "catalogId": {"type": "string", "pattern": "^cosmetics-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100},
    "catalogRevision": {"type": "integer", "minimum": 1},
    "approvalStatus": {"enum": ["FIXTURE_ONLY", "DRAFT", "PRODUCT_APPROVED"]},
    "items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "status", "titleKey", "assetAddress", "pricePatience", "availableByDefault"],
        "properties": {
          "id": {"$ref": "#/$defs/stableId"},
          "type": {"enum": ["TRAIN", "LIVERY", "OPERATING_OBJECT"]},
          "status": {"enum": ["ACTIVE", "HIDDEN", "TOMBSTONE"]},
          "titleKey": {"$ref": "#/$defs/localizationKey"},
          "assetAddress": {"type": "string", "pattern": "^stp/cosmetics/[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 160},
          "pricePatience": {"type": "integer", "minimum": 0, "maximum": 1000000},
          "availableByDefault": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 100},
    "localizationKey": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$", "maxLength": 160}
  }
}
