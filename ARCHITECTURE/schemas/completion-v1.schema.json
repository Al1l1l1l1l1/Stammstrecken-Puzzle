{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stammstrecken-puzzle.invalid/schemas/completion-v1.schema.json",
  "title": "Stammstrecken-Puzzle Completion Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "catalogRevision", "approvalStatus", "rewardDefinitions", "completionMoments"],
  "properties": {
    "schemaVersion": {"const": 1},
    "catalogId": {"type": "string", "pattern": "^completion-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100},
    "catalogRevision": {"type": "integer", "minimum": 1},
    "approvalStatus": {"enum": ["FIXTURE_ONLY", "DRAFT", "PRODUCT_APPROVED"]},
    "rewardDefinitions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reasonCode", "subjectKind", "amountPatience", "claimCardinality"],
        "properties": {
          "reasonCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 64},
          "subjectKind": {"enum": ["LEVEL", "ROUTE", "SECTION", "SEASON", "ENDLESS_INSTANCE"]},
          "amountPatience": {"type": "integer", "minimum": 0, "maximum": 1000000},
          "claimCardinality": {"enum": ["ONCE_PER_SUBJECT", "ONCE_PER_ACHIEVEMENT"]}
        }
      }
    },
    "completionMoments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "resultTextKey", "mapSegmentId", "trainMomentId"],
        "properties": {
          "id": {"$ref": "#/$defs/stableId"},
          "resultTextKey": {"$ref": "#/$defs/localizationKey"},
          "mapSegmentId": {"$ref": "#/$defs/stableId"},
          "trainMomentId": {"$ref": "#/$defs/stableId"}
        }
      }
    }
  },
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 100},
    "localizationKey": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$", "maxLength": 160}
  }
}
