{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stammstrecken-puzzle.invalid/schemas/public-runtime-v1.schema.json",
  "title": "Stammstrecken-Puzzle Runtime Public Catalog v1",
  "description": "ADR044 new locked Production or isolated ContractTest consumer only. Existing Candidate/Review payloads remain unchanged. Typed import checks exact 240 S1 order, geometry/counts/semantic hashes and expected lock; selfhash excludes only catalogHashSha256. Full authoring proof/crossreference/product-approval/release validation is required separately before production composition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogId",
    "revision",
    "use",
    "status",
    "puzzles",
    "catalogHashSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalogId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "use": {
      "enum": [
        "Production",
        "ContractTest"
      ]
    },
    "status": {
      "enum": [
        "PRODUCT_APPROVED",
        "FIXTURE_ONLY"
      ]
    },
    "puzzles": {
      "type": "array",
      "minItems": 240,
      "maxItems": 240,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "puzzleId",
          "rulesetVersion",
          "grid",
          "endpoints",
          "rowCounts",
          "columnCounts",
          "publicPuzzleHash"
        ],
        "properties": {
          "puzzleId": {
            "type": "string",
            "pattern": "^S1-0[1-5]-0[1-4]-(?:0[1-9]|1[0-2])$"
          },
          "rulesetVersion": {
            "const": "train-track-v1"
          },
          "grid": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width",
              "height"
            ],
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 4,
                "maximum": 10
              },
              "height": {
                "type": "integer",
                "minimum": 4,
                "maximum": 10
              }
            }
          },
          "endpoints": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "a",
              "b"
            ],
            "properties": {
              "a": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "side",
                  "index"
                ],
                "properties": {
                  "side": {
                    "enum": [
                      "N",
                      "E",
                      "S",
                      "W"
                    ]
                  },
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9
                  }
                }
              },
              "b": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "side",
                  "index"
                ],
                "properties": {
                  "side": {
                    "enum": [
                      "N",
                      "E",
                      "S",
                      "W"
                    ]
                  },
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9
                  }
                }
              }
            }
          },
          "rowCounts": {
            "type": "array",
            "minItems": 4,
            "maxItems": 10,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            }
          },
          "columnCounts": {
            "type": "array",
            "minItems": 4,
            "maxItems": 10,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            }
          },
          "publicPuzzleHash": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profile",
              "sha256"
            ],
            "properties": {
              "profile": {
                "const": "STP-PUZZLE-SEMANTIC-JCS-1"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "catalogHashSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "use": {
            "const": "Production"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "PRODUCT_APPROVED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "use": {
            "const": "ContractTest"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "FIXTURE_ONLY"
          }
        }
      }
    }
  ]
}
